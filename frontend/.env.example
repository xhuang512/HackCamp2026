# Frontend environment. Copy to .env.local, which git ignores.
#
# Vite inlines every VITE_ var into the public bundle, so only public values
# belong here. Secrets (Gemini key, Supabase service key, code signing secret)
# live on the backend.

# Serve sample payloads from src/lib/fixtures.js instead of calling the API.
# OFF by default now that the endpoints exist. Set it to true to work on the
# screens with the backend stopped; any other value, including unset, talks
# to the real API.
# VITE_USE_FIXTURES=true

# Leave unset in dev: requests go to /api and vite.config.js proxies them to
# the backend. Set this to the deployed API origin in production, with no
# trailing slash.
#
# It has to live in THIS directory. Vite loads env files from the frontend
# root only, so a VITE_API_URL in the repo root .env never reaches the bundle.
# VITE_API_URL=https://your-api.onrender.com

# Where the dev proxy sends /api. Defaults to http://localhost:8000, which is
# uvicorn's default port. Not a VITE_ var: it is read by vite.config.js at
# build time and never reaches the browser.
# BACKEND_PORT=8000
# BACKEND_URL=http://localhost:8000

# Supabase realtime, read-only anon key. Until both are set, src/lib/live.js
# reports 'offline' and holds its initial value.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ---------- Sign-in ----------
#
# Auth0 with its Google connection. UBC-only passwordless email is paused.
# Leave both unset and the welcome screen offers guests only, which is what a
# fresh clone and the stage demo both want. docs/SIGNUP.md has the dashboard
# steps.
#
# These three are public by design. The client id is not a secret: Auth0
# restricts it by callback URL, which is why every URL the app runs on has to
# be listed in the dashboard.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://api.hangout

# Adds "Continue as guest" to the welcome screen. Forced on when Auth0 is
# unconfigured, because otherwise there is no way into the app. The backend's
# own DEMO_MODE decides whether a guest token is actually issued, so turning
# this on alone does not create a way in.
# VITE_DEMO_MODE=true

# Map tiles. OPTIONAL. Leave unset and the map uses OpenStreetMap, which
# needs no key and works everywhere, in light style only.
#
# Set this to use Stadia Maps instead, which has a matching dark style.
# Stadia serves localhost without a key, so you only need this for a
# deployed build. Without it, a deployed map returns HTTP 401 and shows
# nothing. docs/MAP-TILES.md walks through getting one.
#
# This value ends up in the public bundle, like every VITE_ var. That is
# expected for Stadia: the key is restricted by domain in their dashboard,
# not kept secret.
# VITE_STADIA_API_KEY=
