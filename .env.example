SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Signs guest tokens and check-in codes. The backend reads
# GUEST_TOKEN_SECRET first and falls back to this name, which is the one
# already in use. Leave it unset and a random value is generated per
# process, which logs every guest out on every restart.
GUEST_SESSION_SECRET=
CURRENT_TERM=
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL does NOT belong here. Vite loads env files from the frontend
# directory only, so a value set here never reaches the bundle. Put it in
# frontend/.env.local instead. See frontend/.env.example.

# Optional live Supabase integration tests. Tests remain skipped by default.
RUN_SUPABASE_INTEGRATION=0
# Set exactly to YES_I_AM_USING_A_SAFE_TEST_DATABASE to authorize test writes.
SUPABASE_TEST_CONFIRM_WRITES=
# Optional: enables the separate anonymous RLS permission tests.
SUPABASE_ANON_KEY=your-public-anon-key

# Optional SQL setup for a confirmed empty disposable project only.
# These are not required by the backend or ordinary API integration tests.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SQL_SETUP_CONFIRM_PROJECT_REF=
# Set exactly to YES_INITIALIZE_EMPTY_DATABASE to authorize schema installation.
SUPABASE_SQL_SETUP_CONFIRM_EMPTY=
