# Backend environment. Copy to .env, which git ignores.
#
# Unlike the frontend, nothing here reaches the browser, so this is where
# secrets live: the Gemini key, the Supabase service key, the QR signing
# secret and the guest token secret.

# Guest sign-in, POST /admin/reset, and skipping the building location check
# on /scan. The same code is deployed twice, once with this on for the stage.
# On by default while the app is still a skeleton.
DEMO_MODE=true

# Signs guest tokens. Generated per process when unset, which means restarting
# the server logs every guest out. Set it on anything deployed.
# GUEST_TOKEN_SECRET=
# GUEST_TOKEN_HOURS=12

# Auth0. Unset means passwordless email sign-in is off and current_user()
# accepts guest tokens only. AUTH0_AUDIENCE is the API identifier from the
# Auth0 dashboard, not the SPA's client id.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://api.hangout

# Where the frontend is served from. Comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
